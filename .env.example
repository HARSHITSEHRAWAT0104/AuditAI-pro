# AuditAI Pro - Environment Variables Configuration

# Google Gemini API Key (Optional - Fallback Engine active if empty)
GEMINI_API_KEY=your_gemini_api_key_here

# Stripe Subscription Billing Keys
# Get these from your Stripe Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Optional: Custom Stripe Price IDs (from Stripe Products)
STRIPE_PRICE_GROWTH_PRO=price_growth_pro_placeholder
STRIPE_PRICE_AGENCY=price_agency_placeholder

# Server Config
HOST=0.0.0.0
PORT=8000
